package tests;

use ecosystem::yaml;
use std::testing;

#[test]
fn grammar_errors_report_detection_coordinates() -> () {
    for (source, line, column) in Vec::from_array(
        [
            ("[a", 1, 3),
            ("\"abc", 1, 5),
            ("[你好", 1, 4),
            ("\ufeff[你好", 1, 4),
            ("a: [\r\n  x", 2, 4),
            ("a: [\r  x", 2, 4),
            ("a: [\n  x", 2, 4),
            ("a: \u0001", 1, 4),
            ("a: 你\r\nb: \u0001", 2, 4),
            ("%YAML 1.3\n---\na", 1, 10),
        ],
    ) {
        let problem = testing::expect_err(yaml::parse(source), source);
        testing::assert_eq(problem.kind, yaml::ErrorKind::Syntax);
        testing::assert_eq(problem.line, line);
        testing::assert_eq(problem.column, column);
    }
}
